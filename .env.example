# Copiar como .env y completar. El archivo .env real NUNCA debe subirse al repositorio.

# Keycloak (realm externo) — intermedia el login con Ciudadanía Digital.
OIDC_ISSUER=https://desarrollo.gestora.bo/auth/realms/externo
OIDC_CLIENT_ID=app-postulaciones
OIDC_CLIENT_SECRET=
# Debe estar registrada tal cual en Keycloak (Clients → app-postulaciones → Valid redirect URIs).
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/logout
OIDC_SCOPES=openid profile email

# Secreto para firmar la cookie de sesión del servidor (no confundir con OIDC_CLIENT_SECRET).
SESSION_SECRET=

# Laravel (procesos-internos).
API_BACKEND_URL=http://127.0.0.1:8000

# Prefijo público del portal: vacío en local; en el servidor "/portal" (Apache
# reenvía /portal/* a Node sin quitar el prefijo; el build usa --base-href /portal/).
BASE_PATH=
