# Copiar como .env y completar con los valores del panel
# "Configuración de Autenticación con Ciudadanía Digital" (GTALENTO / Proveedor).
# El archivo .env real NUNCA debe subirse al repositorio.

CD_ISSUER=https://proveedor.ciudadania.demo.agetic.gob.bo
CD_CLIENT_ID=
CD_CLIENT_SECRET=
CD_REDIRECT_URI=https://desa-gtalento.gestora.bo/login
CD_POST_LOGOUT_REDIRECT_URI=https://desa-gtalento.gestora.bo/logout
CD_SCOPES=openid profile fecha_nacimiento email celular offline_access

# Secreto para firmar la cookie de sesión del servidor (no confundir con CD_CLIENT_SECRET).
SESSION_SECRET=
